# Google OAuth (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me

# LLM (optional). Without OPENAI_API_KEY the app uses a deterministic offline generator.
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint
LLM_PROVIDER=auto             # auto | openai | mock
LLM_MODEL=gpt-4o-mini

# Submission: auto (live, fall back to mock on failure) | live | mock
SUBMISSION_MODE=auto
